  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Aula 06 - Notebook: Lógica de Predicados e Quantificadores em Redes de Sensores\n",
    "## SCADA-Core Automática — Grupo 04: Classificação e Seleção de Grãos por Visão Computacional\n",
    "\n",
    "Neste notebook implementamos a arquitetura matemática completa da **Lógica de Primeira Ordem (FOL)** aplicada à supervisão em tempo real da planta de classificação de grãos:\n",
    "1. **Operadores de Quantificação Unária e Aninhada** ($\n",
    "orall x$, $\\exists y$, $\n",
    "orall x \\exists y$, $\\exists x \n",
    "orall y$).\n",
    "2. **Varredura Universal e Existencial da Malha de Instrumentos ISA 5.1** e subsistemas críticos.\n",
    "3. **Classificação Disjunta de Lotes de Grãos** ($\\mathcal{G}$) com cálculo de métricas de qualidade e quantificação estatística ponderada.\n",
    "4. **Mapeamento de Interdependência Sensores $\\leftrightarrow$ Atuadores** com quantificadores aninhados.\n",
    "5. **Simulador de Varredura Multiciclo (*Scan Cycle Engine*)** com injeção dinâmica de perturbações e relatórios de telemetria.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def formatar_tabela(dados):\n",
    "    \"\"\"Formata lista de dicionários em tabela ASCII pura alinhada.\"\"\"\n",
    "    if not dados:\n",
    "        return \"Tabela Vazia\"\n",
    "    colunas = list(dados[0].keys())\n",
    "    larguras = {c: len(str(c)) for c in colunas}\n",
    "    for row in dados:\n",
    "        for c in colunas:\n",
    "            larguras[c] = max(larguras[c], len(str(row.get(c, \"\"))))\n",
    "    header = \" | \".join(f\"{c:<{larguras[c]}}\" for c in colunas)\n",
    "    divisor = \"-+-\".join(\"-\" * larguras[c] for c in colunas)\n",
    "    linhas = [header, divisor]\n",
    "    for row in dados:\n",
    "        linhas.append(\" | \".join(f\"{str(row.get(c, '')):<{larguras[c]}}\" for c in colunas))\n",
    "    return \"\\n\".join(linhas)\n",
    "\n",
    "from dataclasses import dataclass, field\n",
    "from typing import List, Callable, Any, Dict, Optional, Tuple\n",
    "import math\n",
    "\n",
    "@dataclass\n",
    "class SensorProcesso:\n",
    "    tag: str\n",
    "    setor: str\n",
    "    tipo: str\n",
    "    valor: float\n",
    "    unidade: str\n",
    "    limite_min: float\n",
    "    limite_max: float\n",
    "    falha_comunicacao: bool = False\n",
    "    calibrado: bool = True\n",
    "\n",
    "    @property\n",
    "    def saudavel(self) -> bool:\n",
    "        return (not self.falha_comunicacao) and self.calibrado\n",
    "\n",
    "    @property\n",
    "    def alarme_ativo(self) -> bool:\n",
    "        if self.falha_comunicacao or not self.calibrado:\n",
    "            return True\n",
    "        return self.valor < self.limite_min or self.valor > self.limite_max\n",
    "\n",
    "@dataclass\n",
    "class AtuadorProcesso:\n",
    "    tag: str\n",
    "    nome: str\n",
    "    setor: str\n",
    "    acionado: bool\n",
    "    sensor_confirmacao: str # Tag do sensor que valida o acionamento\n",
    "    potencia_nominal_kw: float\n",
    "    bloqueado_intertravamento: bool = False\n",
    "\n",
    "@dataclass\n",
    "class Grao:\n",
    "    id_grao: int\n",
    "    cor_ideal: bool\n",
    "    tamanho_ideal: bool\n",
    "    formato_ideal: bool\n",
    "    dano: bool\n",
    "    praga: bool\n",
    "    impureza: bool\n",
    "    massa_g: float\n",
    "    posicao_mm: float = 0.0\n",
    "\n",
    "@dataclass\n",
    "class Reservatorio:\n",
    "    tag: str\n",
    "    nome: str\n",
    "    nivel_pct: float\n",
    "    capacidade_kg: float\n",
    "\n",
    "# ==============================================================================\n",
    "# OPERADORES FUNDAMENTAIS DA LÓGICA DE PREDICADOS DE PRIMEIRA ORDEM (FOL)\n",
    "# ==============================================================================\n",
    "def FORALL(dominio: List[Any], predicado: Callable[[Any], bool]) -> bool:\n",
    "    \"\"\"Quantificador Universal Simples: FORALL x in D, P(x)\"\"\"\n",
    "    return all(predicado(x) for x in dominio)\n",
    "\n",
    "def EXISTS(dominio: List[Any], predicado: Callable[[Any], bool]) -> bool:\n",
    "    \"\"\"Quantificador Existencial Simples: EXISTS x in D, P(x)\"\"\"\n",
    "    return any(predicado(x) for x in dominio)\n",
    "\n",
    "def COUNT_IF(dominio: List[Any], predicado: Callable[[Any], bool]) -> int:\n",
    "    \"\"\"Contador condicional de predicados verdadeiros\"\"\"\n",
    "    return sum(1 for x in dominio if predicado(x))\n",
    "\n",
    "def FORALL_EXISTS(dominio_x: List[Any], dominio_y: List[Any], relacao: Callable[[Any, Any], bool]) -> bool:\n",
    "    \"\"\"Quantificador Aninhado FORALL x in Dx, EXISTS y in Dy, R(x, y)\"\"\"\n",
    "    return all(any(relacao(x, y) for y in dominio_y) for x in dominio_x)\n",
    "\n",
    "def EXISTS_FORALL(dominio_x: List[Any], dominio_y: List[Any], relacao: Callable[[Any, Any], bool]) -> bool:\n",
    "    \"\"\"Quantificador Aninhado EXISTS x in Dx, FORALL y in Dy, R(x, y)\"\"\"\n",
    "    return any(all(relacao(x, y) for y in dominio_y) for x in dominio_x)\n",
    "\n",
    "def FORALL_PERCENT(dominio: List[Any], predicado: Callable[[Any], bool], percentual_min: float) -> bool:\n",
    "    \"\"\"Quantificador Ponderado de Conformidade Estatística\"\"\"\n",
    "    if not dominio:\n",
    "        return False\n",
    "    return (COUNT_IF(dominio, predicado) / len(dominio)) >= percentual_min\n",
    "\n",
    "print(\"[OK] Módulo central de estruturas de dados e operadores FOL inicializado com sucesso!\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Malha de Sensores ISA 5.1 e Varredura de Integridade ($\\mathcal{S}_{\text{crit}}$)\n",
    "Varredura de integridade operacional de instrumentos críticos e checagem de conformidade de grandezas físicas.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Catálogo Oficial de Instrumentos da Planta de Seleção de Grãos (ISA 5.1)\n",
    "rede_sensores = [\n",
    "    SensorProcesso('LIT-101', 'Recepção/Funil', 'NIVEL',       65.0, '%',   15.0, 95.0),\n",
    "    SensorProcesso('ST-201',  'Tração Esteira', 'VELOCIDADE',  1.2,  'm/s', 0.8,  1.5),\n",
    "    SensorProcesso('JI-201',  'Motor Esteira',  'CORRENTE',    4.2,  'A',   0.0,  6.0),\n",
    "    SensorProcesso('WT-301',  'Pesagem',        'MASSA',       25.4, 'g',   0.0,  100.0),\n",
    "    SensorProcesso('XS-401',  'Visão/Trigger',  'PRESENCA',    1.0,  'bin', 0.0,  1.0),\n",
    "    SensorProcesso('KSA-401', 'Visão/Câmera',   'STATUS',      1.0,  'bin', 1.0,  1.0),\n",
    "    SensorProcesso('PAL-601', 'Pneumática',     'PRESSAO',     6.2,  'bar', 5.0,  8.0),\n",
    "    SensorProcesso('ZSH-601', 'Ejetor FY-603',  'POSICAO',     0.0,  'bin', 0.0,  1.0),\n",
    "    SensorProcesso('LIT-703', 'Silo Rejeito C', 'NIVEL',       42.0, '%',   0.0,  90.0),\n",
    "    SensorProcesso('XA-901',  'Segurança',      'EMERGENCIA',  0.0,  'bin', 0.0,  0.0),\n",
    "]\n",
    "\n",
    "tags_criticas = {'XA-901', 'JI-201', 'PAL-601', 'KSA-401', 'LIT-703'}\n",
    "sensores_criticos = [s for s in rede_sensores if s.tag in tags_criticas]\n",
    "\n",
    "# Avaliação dos Quantificadores em Regime Nominal\n",
    "todos_sensores_saudaveis = FORALL(rede_sensores, lambda s: s.saudavel)\n",
    "todos_criticos_normais   = FORALL(sensores_criticos, lambda s: not s.alarme_ativo)\n",
    "existe_anomalia_critica  = EXISTS(sensores_criticos, lambda s: s.alarme_ativo)\n",
    "pressao_pneumatica_valida = FORALL([s for s in rede_sensores if s.tipo == 'PRESSAO'], lambda s: s.valor >= 5.0)\n",
    "\n",
    "print(f\"1. Todos os Sensores da Planta Saudáveis (FORALL): {todos_sensores_saudaveis}\")\n",
    "print(f\"2. Todos os Sensores Críticos em Faixa Segura (FORALL): {todos_criticos_normais}\")\n",
    "print(f\"3. Existe Alguma Anomalia Crítica Ativa (EXISTS): {existe_anomalia_critica}\")\n",
    "print(f\"4. Pressão Pneumática em Nível Operacional (FORALL): {pressao_pneumatica_valida}\")\n",
    "\n",
    "tabela_sensores = [\n",
    "    {\n",
    "        \"Tag ISA\": s.tag,\n",
    "        \"Setor\": s.setor,\n",
    "        \"Variável\": s.tipo,\n",
    "        \"Leitura\": f\"{s.valor} {s.unidade}\",\n",
    "        \"Faixa Permitida\": f\"[{s.limite_min} a {s.limite_max}] {s.unidade}\",\n",
    "        \"Saúde\": \"OK\" if s.saudavel else \"FALHA\",\n",
    "        \"Alarme\": \"ATIVO\" if s.alarme_ativo else \"NORMAL\"\n",
    "    }\n",
    "    for s in rede_sensores\n",
    "]\n",
    "print(\"\\n=== STATUS DETALHADO DA REDE DE SENSORES (SCADA-CORE) ===\")\n",
    "print(formatar_tabela(tabela_sensores))\n",
    "\n",
    "assert todos_sensores_saudaveis is True\n",
    "assert todos_criticos_normais is True\n",
    "assert existe_anomalia_critica is False\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Quantificadores Aninhados: Relação Sensores $\\leftrightarrow$ Atuadores\n",
    "Modelagem da propriedade de rastreabilidade e segurança com quantificadores de primeira ordem:\n",
    "$$\n",
    
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Definição dos Atuadores e Motores da Planta\n",
    "atuadores_planta = [\n",
    "    AtuadorProcesso('ALIM-101', 'Alimentador Vibratório', 'Recepção', acionado=True,  sensor_confirmacao='LIT-101', potencia_nominal_kw=1.5),\n",
    "    AtuadorProcesso('MOT-201',  'Motor da Esteira',       'Tração',   acionado=True,  sensor_confirmacao='ST-201',  potencia_nominal_kw=3.0),\n",
    "    AtuadorProcesso('CAM-401',  'Iluminação/Trigger CAM', 'Visão',    acionado=True,  sensor_confirmacao='KSA-401', potencia_nominal_kw=0.2),\n",
    "    AtuadorProcesso('VALV-603', 'Solenoide Ejetor C',     'Ejeção',   acionado=False, sensor_confirmacao='ZSH-601', potencia_nominal_kw=0.5),\n",
    "]\n",
    "\n",
    "def ConfirmaOperacao(a: AtuadorProcesso, s: SensorProcesso) -> bool:\n",
    "    \"\"\"Predicado binário: O sensor s é o instrumento oficial de feedback do atuador a e está saudável\"\"\"\n",
    "    if a.sensor_confirmacao == s.tag:\n",
    "        return s.saudavel and (not s.falha_comunicacao)\n",
    "    return False\n",
    "\n",
    "# Quantificador Aninhado: Para todo atuador, existe um sensor correspondente que valida sua operação\n",
    "todos_atuadores_monitorados = FORALL_EXISTS(atuadores_planta, rede_sensores, ConfirmaOperacao)\n",
    "\n",
    "# Quantificador: Não existe atuador energizado com bloqueio de intertravamento\n",
    "nenhum_atuador_bloqueado = FORALL(atuadores_planta, lambda a: not a.bloqueado_intertravamento)\n",
    "\n",
    "print(f\"1. Relacao FORALL a EXISTS s ConfirmaOperacao(s, a): {todos_atuadores_monitorados}\")\n",
    "print(f\"2. Todos os Atuadores Livres de Bloqueio (FORALL): {nenhum_atuador_bloqueado}\")\n",
    "\n",
    "tabela_atuadores = [\n",
    "    {\n",
    "        \"Tag Atuador\": a.tag,\n",
    "        \"Equipamento\": a.nome,\n",
    "        \"Setor\": a.setor,\n",
    "        \"Acionado\": \"SIM\" if a.acionado else \"NÃO\",\n",
    "        \"Sensor Feedback\": a.sensor_confirmacao,\n",
    "        \"Potência\": f\"{a.potencia_nominal_kw} kW\",\n",
    "        \"Monitoramento\": \"CONFIRMADO\" if any(ConfirmaOperacao(a, s) for s in rede_sensores) else \"SEM SENSOR\"\n",
    "    }\n",
    "    for a in atuadores_planta\n",
    "]\n",
    "print(\"\\n=== MATRIZ DE FEEDBACK ATUADORES - SENSORES ===\")\n",
    "print(formatar_tabela(tabela_atuadores))\n",
    "\n",
    "assert todos_atuadores_monitorados is True\n",
    "assert nenhum_atuador_bloqueado is True\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Varredura de Lotes de Grãos ($\\mathcal{G}$), Classificação e Partição Disjunta\n",
    "Verificação formal de que cada grão pertence a exatamente uma categoria e quantificação de pureza de lote.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# População de Grãos no Ciclo de Amostragem\n",
    "lote_graos = [\n",
    "    Grao(1,  cor_ideal=True,  tamanho_ideal=True,  formato_ideal=True,  dano=False, praga=False, impureza=False, massa_g=0.025, posicao_mm=100.0), # Cat A\n",
    "    Grao(2,  cor_ideal=True,  tamanho_ideal=True,  formato_ideal=True,  dano=False, praga=False, impureza=False, massa_g=0.024, posicao_mm=180.0), # Cat A\n",
    "    Grao(3,  cor_ideal=False, tamanho_ideal=True,  formato_ideal=True,  dano=False, praga=False, impureza=False, massa_g=0.023, posicao_mm=260.0), # Cat B\n",
    "    Grao(4,  cor_ideal=True,  tamanho_ideal=True,  formato_ideal=True,  dano=True,  praga=False, impureza=False, massa_g=0.021, posicao_mm=340.0), # Cat C (Dano)\n",
    "    Grao(5,  cor_ideal=True,  tamanho_ideal=False, formato_ideal=True,  dano=False, praga=False, impureza=False, massa_g=0.020, posicao_mm=420.0), # Cat B\n",
    "    Grao(6,  cor_ideal=True,  tamanho_ideal=True,  formato_ideal=True,  dano=False, praga=True,  impureza=False, massa_g=0.022, posicao_mm=500.0), # Cat C (Praga)\n",
    "    Grao(7,  cor_ideal=True,  tamanho_ideal=True,  formato_ideal=True,  dano=False, praga=False, impureza=False, massa_g=0.026, posicao_mm=580.0), # Cat A\n",
    "    Grao(8,  cor_ideal=False, tamanho_ideal=False, formato_ideal=True,  dano=False, praga=False, impureza=False, massa_g=0.019, posicao_mm=660.0), # Cat B\n",
    "    Grao(9,  cor_ideal=True,  tamanho_ideal=True,  formato_ideal=True,  dano=False, praga=False, impureza=True,  massa_g=0.035, posicao_mm=740.0), # Cat C (Impureza)\n",
    "    Grao(10, cor_ideal=True,  tamanho_ideal=True,  formato_ideal=True,  dano=False, praga=False, impureza=False, massa_g=0.025, posicao_mm=820.0), # Cat A\n",
    "    Grao(11, cor_ideal=True,  tamanho_ideal=True,  formato_ideal=True,  dano=False, praga=False, impureza=False, massa_g=0.024, posicao_mm=900.0), # Cat A\n",
    "    Grao(12, cor_ideal=True,  tamanho_ideal=True,  formato_ideal=True,  dano=False, praga=False, impureza=False, massa_g=0.025, posicao_mm=980.0), # Cat A\n",
    "]\n",
    "\n",
    "# Predicados Lógicos de Qualidade do Grão\n",
    "def Conforme_A(g: Grao) -> bool:\n",
    "    \"\"\"Categoria A: Grão Padrão Exportação (Cor, Tamanho e Formato Ideais sem qualquer defeito)\"\"\"\n",
    "    return g.cor_ideal and g.tamanho_ideal and g.formato_ideal and not (g.dano or g.praga or g.impureza)\n",
    "\n",
    "def Defeituoso_C(g: Grao) -> bool:\n",
    "    \"\"\"Categoria C: Grão Rejeitado (Presença de Dano Mecânico, Pragas ou Impurezas)\"\"\"\n",
    "    return g.dano or g.praga or g.impureza\n",
    "\n",
    "def Secundario_B(g: Grao) -> bool:\n",
    "    \"\"\"Categoria B: Grão Comercial Secundário (Não é Cat A e não possui defeito grave de descarte)\"\"\"\n",
    "    return not Conforme_A(g) and not Defeituoso_C(g)\n",
    "\n",
    "# Prova da Partição Exaustiva e Disjunta (FORALL g in G, exatamente uma categoria é satisfeita)\n",
    "particao_valida = FORALL(lote_graos, lambda g: (int(Conforme_A(g)) + int(Secundario_B(g)) + int(Defeituoso_C(g))) == 1)\n",
    "\n",
    "total_graos = len(lote_graos)\n",
    "qtd_a = COUNT_IF(lote_graos, Conforme_A)\n",
    "qtd_b = COUNT_IF(lote_graos, Secundario_B)\n",
    "qtd_c = COUNT_IF(lote_graos, Defeituoso_C)\n",
    "taxa_rejeicao = qtd_c / total_graos\n",
    "taxa_aprovacao = qtd_a / total_graos\n",
    "\n",
    "# Quantificador Ponderado: Lote com conformidade mínima de 40% Categoria A\n",
    "lote_qualificado = FORALL_PERCENT(lote_graos, Conforme_A, 0.40)\n",
    "\n",
    "print(f\"1. Partição Exaustiva e Disjunta (FORALL): {particao_valida}\")\n",
    "print(f\"2. Total de Grãos: {total_graos} | Cat A: {qtd_a} ({taxa_aprovacao*100:.1f}%) | Cat B: {qtd_b} | Cat C: {qtd_c} ({taxa_rejeicao*100:.1f}%)\")\n",
    "print(f\"3. Lote Aprovado pelo Critério Estatístico (FORALL_PERCENT >= 40%): {lote_qualificado}\")\n",
    "\n",
    "tabela_graos = [\n",
    "    {\n",
    "        \"ID\": g.id_grao,\n",
    "        \"Cor\": \"IDEAL\" if g.cor_ideal else \"FORA\",\n",
    "        \"Tamanho\": \"IDEAL\" if g.tamanho_ideal else \"FORA\",\n",
    "        \"Formato\": \"IDEAL\" if g.formato_ideal else \"FORA\",\n",
    "        \"Defeito\": \"DANO\" if g.dano else (\"PRAGA\" if g.praga else (\"IMPUREZA\" if g.impureza else \"NENHUM\")),\n",
    "        \"Classificação\": \"Categoria A\" if Conforme_A(g) else (\"Categoria B\" if Secundario_B(g) else \"Categoria C (Ejetar)\")\n",
    "    }\n",
    "    for g in lote_graos\n",
    "]\n",
    "print(\"\\n=== CLASSIFICAÇÃO AUTOMATIZADA DOS GRÃOS POR VISÃO COMPUTACIONAL ===\")\n",
    "print(formatar_tabela(tabela_graos))\n",
    "\n",
    "assert particao_valida is True\n",
    "assert (qtd_a + qtd_b + qtd_c) == total_graos\n",
    "assert lote_qualificado is True\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Simulador de Varredura Cíclica (*Scan Cycle Engine*) com Injeção de Falhas\n",
    "Execução de simulação em tempo real de múltiplos ciclos de varredura do CLP/SCADA, testando a resposta do intertravamento sob diferentes cenários de falha.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Definição dos Reservatórios\n",
    "reservatorios = [\n",
    "    Reservatorio('SILO-A',  'Silo Categoria A (Aprovados)',  45.0, 5000.0),\n",
    "    Reservatorio('SILO-B',  'Silo Categoria B (Secundário)', 30.0, 3000.0),\n",
    "    Reservatorio('SILO-C',  'Silo Categoria C (Rejeitos)',   42.0, 2000.0),\n",
    "    Reservatorio('FUN-101', 'Funil de Recepção Bruto',       65.0,  500.0)\n",
    "]\n",
    "\n",
    "def executar_scan_cycle(ciclo_id: int, perturba_tag: Optional[str] = None, novo_valor: Optional[float] = None) -> Dict[str, Any]:\n",
    "    \"\"\"Executa um ciclo completo de varredura FOL no SCADA-Core\"\"\"\n",
    "    if perturba_tag:\n",
    "        sensor = next(s for s in rede_sensores if s.tag == perturba_tag)\n",
    "        sensor.valor = novo_valor\n",
    "\n",
    "    saude_sensores   = FORALL(rede_sensores, lambda s: s.saudavel)\n",
    "    seguranca_malha  = FORALL(sensores_criticos, lambda s: not s.alarme_ativo)\n",
    "    silos_ok         = FORALL(reservatorios, lambda r: r.nivel_pct < 90.0)\n",
    "    existe_alarme    = EXISTS(sensores_criticos, lambda s: s.alarme_ativo)\n",
    "    \n",
    "    c_PERM = saude_sensores and seguranca_malha and silos_ok\n",
    "    c_ALIM = c_PERM and (next(s for s in rede_sensores if s.tag == 'ST-201').valor > 0.5)\n",
    "\n",
    "    return {\n",
    "        \"Ciclo\": f\"Scan #{ciclo_id}\",\n",
    "        \"Perturbação Injetada\": f\"{perturba_tag}={novo_valor}\" if perturba_tag else \"Operação Normal\",\n",
    "        \"Sensores Saudáveis\": \"SIM\" if saude_sensores else \"NÃO\",\n",
    "        \"Alarme Ativo\": \"SIM\" if existe_alarme else \"NÃO\",\n",
    "        \"Silos OK\": \"SIM\" if silos_ok else \"CRÍTICO\",\n",
    "        \"c_PERM\": \"LIBERADO\" if c_PERM else \"BLOQUEADO\",\n",
    "        \"c_ALIM\": \"LIGADO\" if c_ALIM else \"DESLIGADO\"\n",
    "    }\n",
    "\n",
    "historico_scans = []\n",
    "historico_scans.append(executar_scan_cycle(1))                                                  # Ciclo 1: Nominal\n",
    "historico_scans.append(executar_scan_cycle(2, perturba_tag='PAL-601', novo_valor=3.2))         # Ciclo 2: Queda de Pressão (3.2 bar)\n",
    "historico_scans.append(executar_scan_cycle(3, perturba_tag='PAL-601', novo_valor=6.5))         # Ciclo 3: Pressão Normalizada\n",
    "historico_scans.append(executar_scan_cycle(4, perturba_tag='XA-901',  novo_valor=1.0))         # Ciclo 4: Emergência Pressionada\n",
    "\n",
    "print(\"=== LOG DE TELEMETRIA DO SIMULADOR DE SCAN MULTICICLO ===\")\n",
    "print(formatar_tabela(historico_scans))\n",
    "\n",
    "assert historico_scans[0]['c_PERM'] == 'LIBERADO'\n",
    "assert historico_scans[1]['c_PERM'] == 'BLOQUEADO' # Queda de pressão bloqueou c_PERM\n",
    "assert historico_scans[2]['c_PERM'] == 'LIBERADO'  # Recuperou\n",
    "assert historico_scans[3]['c_PERM'] == 'BLOQUEADO' # Emergência bloqueou\n",
    "print(\"\\n[OK] Simulação multiciclo validou todos os comportamentos dinâmicos com sucesso!\")\n"
   ]
